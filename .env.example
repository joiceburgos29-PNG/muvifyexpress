# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# Google Maps browser key (restrict this key by HTTP referrer in Google Cloud)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Public business contact details
VITE_WHATSAPP_NUMBER=34667527326

# Server-only Vercel environment variables — do not prefix these with VITE_
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Muvify Express <presupuestos@your-verified-domain.com>
QUOTE_RECIPIENT_EMAIL=info@muvify.es

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# App Environment
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=false
